[Unit]
Description=Home Assistant
Wants=matter-server.service
After=matter-server.service

[Service]
Restart=on-failure
TimeoutStartSec=900
StateDirectory=homeassistant
UserNS=auto

# Install HACS (Home Assistant Community Store) into the config volume if missing.
ExecStartPre=/usr/bin/bash -c 'test -d %S/homeassistant/custom_components/hacs || (install -d %S/homeassistant/custom_components/hacs && curl -fsSL https://github.com/hacs/integration/releases/latest/download/hacs.zip -o /tmp/hacs.zip && python3 -m zipfile -e /tmp/hacs.zip %S/homeassistant/custom_components/hacs/ && rm -f /tmp/hacs.zip)'

[Container]
Image=ghcr.io/home-assistant/home-assistant:stable
ContainerName=homeassistant
Environment=TZ=Europe/Paris
Network=host

Volume=%S/homeassistant:/config:U,Z

AutoUpdate=registry

[Install]
WantedBy=multi-user.target

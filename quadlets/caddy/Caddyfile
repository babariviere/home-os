*.babariviere.com {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1
	}

	@paperless host paperless.babariviere.com
	handle @paperless {
		reverse_proxy paperless:8000
	}

	@notes host notes.babariviere.com
	handle @notes {
		reverse_proxy silverbullet:3000
	}

	@homeassistant host home.babariviere.com
	handle @homeassistant {
		reverse_proxy host.containers.internal:8123
	}

	@bookorbit host books.babariviere.com
	handle @bookorbit {
		reverse_proxy bookorbit:3000
	}

	@shelfmark host shelfmark.babariviere.com
	handle @shelfmark {
		reverse_proxy shelfmark:8084
	}

	@curator host curator.babariviere.com
	handle @curator {
		reverse_proxy curator:8080
	}

	# Suwayomi ships no sources: the extension catalog is installed through this
	# UI, which is the only reason it is proxied at all.
	@suwayomi host suwayomi.babariviere.com
	handle @suwayomi {
		reverse_proxy suwayomi:4567
	}

}

# Books-only listener used ONLY by the Cloudflare Tunnel (cloudflared).
# Not published to the host (no PublishPort), so it is reachable only from
# inside the caddy network. cloudflared forwards books.babariviere.com here.
# Serving a single vhost means the tunnel can never reach any other site,
# even if a request with a different Host somehow arrived.
:8080 {
	@books host books.babariviere.com
	handle @books {
		reverse_proxy bookorbit:3000
	}

	handle {
		respond 404
	}
}

# Curator download-only listener, used ONLY by the Cloudflare Tunnel.
# Not published to the host, so it is reachable only from inside the caddy
# network. Same single-vhost shape as the books listener above, narrowed
# further: only /proxy/{token} is served, so search, resolve and capabilities
# stay on the LAN with their API key, and the public surface is one route whose
# token IS the credential (256-bit, single purpose, short-lived).
#
# This exists because BookOrbit refuses a download URL that resolves to a
# private address (bookorbit/bookorbit#1381), and a Suwayomi release has no URL
# other than one pointing back here: curator assembles the archive on demand, so
# there is nothing to hand over until it does.
:8081 {
	@curator {
		host curator.babariviere.com
		path /proxy/*
	}
	handle @curator {
		reverse_proxy curator:8080
	}

	handle {
		respond 404
	}
}


[Unit]
Description=Shelfarr ebook request & download manager (download-only)

[Service]
Restart=on-failure
TimeoutStartSec=900
# storage: SQLite DBs, Active Storage files, logs, auto-generated RAILS_MASTER_KEY.
# downloads: point this at your download client's completed-downloads folder.
StateDirectory=shelfarr/storage shelfarr/downloads

[Container]
Pod=shelfarr.pod
Image=ghcr.io/pedro-revez-silva/shelfarr:latest
ContainerName=shelfarr

Environment=RAILS_ENV=production
Environment=SOLID_QUEUE_IN_PUMA=1
Environment=HTTP_PORT=80
Environment=PUID=0
Environment=PGID=0
Environment=CHOWN_ON_START=auto

Volume=%S/shelfarr/storage:/rails/storage:U,Z
Volume=%S/shelfarr/downloads:/downloads:U,Z
# Download-only: finished ebooks land in BookOrbit's shared Book Dock so each user
# imports/finalizes what they want. Leave Shelfarr's library platform unset.
# Shared /var/srv dir (backing 1000:1000) idmapped to container-root; keeps
# UserNS=auto on both pods. Provisioned by /usr/lib/tmpfiles.d/book-dock.conf.
Volume=/var/srv/book-dock:/ebooks:z,idmap=uids=@1000-0-1;gids=@1000-0-1

HealthCmd=curl -f http://127.0.0.1:80/up
HealthStartPeriod=40s
HealthInterval=30s
HealthOnFailure=restart
HealthRetries=3

AutoUpdate=registry

[Install]
WantedBy=multi-user.target

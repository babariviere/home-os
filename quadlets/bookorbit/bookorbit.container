[Unit]
Description=BookOrbit reading platform
After=bookorbit-db.service
Requires=bookorbit-db.service

[Service]
Restart=on-failure
TimeoutStartSec=900
StateDirectory=bookorbit/app bookorbit/books

[Container]
Pod=bookorbit.pod
Image=ghcr.io/bookorbit/bookorbit:latest
ContainerName=bookorbit-app

Environment=NODE_ENV=production
Environment=PORT=3000
Environment=POSTGRES_HOST=bookorbit-db
Environment=POSTGRES_PORT=5432
Environment=POSTGRES_USER=bookorbit
Environment=POSTGRES_DB=bookorbit
Environment=APP_URL=https://books.babariviere.com
Environment=LIBRARY_BROWSE_ROOT=/books
Environment=NODE_MAX_OLD_SPACE_SIZE=2048
Environment=PUID=0
Environment=PGID=0
# Book Dock watched drop folder (Shelfmark delivers here for per-user import)
Environment=BOOK_DOCK_PATH=/dock

Secret=bookorbit-postgres-password,type=env,target=POSTGRES_PASSWORD
Secret=bookorbit-jwt-secret,type=env,target=JWT_SECRET
Secret=bookorbit-setup-token,type=env,target=SETUP_BOOTSTRAP_TOKEN

Volume=%S/bookorbit/app:/data:U,Z
Volume=%S/bookorbit/books:/books:U,Z
# Shared Book Dock on /var/srv (backing owner 1000:1000). BookOrbit's app runs
# as container-root (PUID=0), so the idmap's second value MUST be 0 (@1000-0-1)
# to get read+write; only that combo passed the on-host test matrix. Shelfmark
# runs as uid 1000 and uses @1000-1000-1 on the same dir (asymmetric is correct
# because the value tracks each container's process uid). Keeps UserNS=auto.
Volume=/var/srv/book-dock:/dock:z,idmap=uids=@1000-0-1;gids=@1000-0-1

HealthCmd=node -e "fetch('http://127.0.0.1:3000/api/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
HealthStartPeriod=20s
HealthInterval=30s
HealthOnFailure=restart
HealthRetries=3

AutoUpdate=registry

[Install]
WantedBy=multi-user.target

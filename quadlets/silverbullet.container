[Unit]
Description=Silverbullet is a note taking app

[Service]
Restart=on-failure
TimeoutStartSec=900
StateDirectory=silverbullet

[Container]
Image=ghcr.io/silverbulletmd/silverbullet:3.0.0@sha256:02e9d68a240cda0d5f3ea08b81fad9fe84aff629d91ff4145230fdaea37cab6c
ContainerName=silverbullet
Environment=TZ=Europe/Paris
# Ensure silverbullet doesn't create a user
Environment=PUID=0

PublishPort=3000:3000
Volume=%S/silverbullet:/space:U,Z

Network=caddy.network

HealthCmd=curl -f http://localhost:3000/.ping
HealthStartPeriod=30s
HealthInterval=10s
HealthOnFailure=restart
HealthRetries=5

AutoUpdate=registry

UserNS=auto

[Install]
WantedBy=multi-user.target

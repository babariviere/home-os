[Unit]
Description=Document manager
After=paperless-redis.service
Requires=paperless-redis.service

[Service]
Restart=on-failure
TimeoutStartSec=900
StateDirectory=paperless/data paperless/media paperless/export paperless/consume

[Container]
Pod=paperless.pod
Image=ghcr.io/paperless-ngx/paperless-ngx:latest@sha256:65a4cabf0169ea7fbd90ab7bb28ba3f8b5909613635acda1a03ad606f34b456b
ContainerName=paperless

Environment=PAPERLESS_REDIS=redis://paperless-redis:6379
Environment="PAPERLESS_FILENAME_FORMAT={{ created_year }}/{{ correspondent }}/{{ title }}"

# Recent paperless-ngx makes PAPERLESS_SECRET_KEY mandatory (init-migrations
# exits 1 otherwise). Provisioned out-of-band as a podman secret:
#   openssl rand -hex 48 | tr -d '\n' | podman secret create paperless-secret-key -
Secret=paperless-secret-key,type=env,target=PAPERLESS_SECRET_KEY

Volume=%S/paperless/data:/usr/src/paperless/data:U,Z
Volume=%S/paperless/media:/usr/src/paperless/media:U,Z
Volume=%S/paperless/export:/usr/src/paperless/export:U,Z
Volume=%S/paperless/consume:/usr/src/paperless/consume:U,Z

HealthCmd=curl -f http://localhost:8000
# Paperless recursively chowns the whole media tree (:U) then runs migrations
# and boots Django before port 8000 answers, which takes minutes on a large
# library. A short start period let HealthOnFailure=restart kill it mid-boot,
# causing an endless restart loop. Give it room to finish starting.
HealthStartPeriod=300s
HealthInterval=10s
HealthOnFailure=restart
HealthRetries=5

AutoUpdate=registry

[Install]
WantedBy=multi-user.target

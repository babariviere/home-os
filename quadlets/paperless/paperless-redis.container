[Unit]
Description=Redis for paperless

[Service]
Restart=on-failure
TimeoutStartSec=900

[Container]
Pod=paperless.pod
Image=docker.io/library/redis:8-alpine@sha256:978f0e01593e65eed801f2402944efcd936d43b5027e4908a7897baf88ed6241
ContainerName=paperless-redis

Volume=paperless-redis:/data:U,Z

HealthCmd=redis-cli ping
HealthStartPeriod=10s
HealthInterval=10s
HealthOnFailure=restart
HealthRetries=5

AutoUpdate=registry

[Install]
WantedBy=multi-user.target

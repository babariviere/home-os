[Unit]
Description=Reverse proxy

[Service]
Restart=on-failure
UserNS=auto

[Install]
WantedBy=multi-user.target

[Container]
Image=caddy.build
ContainerName=caddy

Network=caddy.network
HostName=caddy
PublishPort=80:80
PublishPort=443:443
PublishPort=443:443/udp

Volume=caddy-config:/config
Volume=caddy-data:/data

Volume=./Caddyfile:/etc/caddy/Caddyfile

Secret=cloudflare-api-token,type=env,target=CF_API_TOKEN

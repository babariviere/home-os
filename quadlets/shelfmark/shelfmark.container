[Unit]
Description=Shelfmark book search & request tool (download-only)

[Service]
Restart=on-failure
TimeoutStartSec=900
# config: app configuration, database and artwork cache.
StateDirectory=shelfmark/config

[Container]
Pod=shelfmark.pod
Image=ghcr.io/calibrain/shelfmark:latest
ContainerName=shelfmark

Environment=PUID=1000
Environment=PGID=1000
# Use Shelfmark's built-in SeleniumBase bypasser. FlareSolverr can't solve the
# DDoS-Guard challenge on Anna's Archive mirrors, so external bypass fails.
Environment=USE_CF_BYPASS=true

Volume=%S/shelfmark/config:/config:U,Z
# Download-only: books land in BookOrbit's shared Book Dock so each user imports
# and finalizes what they want. Shared /var/srv dir (backing 1000:1000). Shelfmark
# runs as uid 1000 so it uses @1000-1000-1; BookOrbit runs as root and uses
# @1000-0-1 on the same dir. The idmap value tracks each container's process uid.
Volume=/var/srv/book-dock:/books:z,idmap=uids=@1000-1000-1;gids=@1000-1000-1

HealthCmd=curl -sf http://localhost:8084/api/health
HealthStartPeriod=60s
HealthInterval=60s
HealthOnFailure=restart
HealthRetries=3

AutoUpdate=registry

[Install]
WantedBy=multi-user.target

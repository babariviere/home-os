[Unit]
Description=FlareSolverr Cloudflare bypass proxy for Shelfmark

[Service]
Restart=on-failure
TimeoutStartSec=900
StateDirectory=shelfmark/flaresolverr

[Container]
Pod=shelfmark.pod
Image=ghcr.io/flaresolverr/flaresolverr:latest
ContainerName=flaresolverr

Environment=TZ=Europe/Paris
Environment=LOG_LEVEL=info
Environment=LOG_HTML=false
Environment=CAPTCHA_SOLVER=none

Volume=%S/shelfmark/flaresolverr:/config:U,Z

# Chromium-backed; give it headroom.
Memory=1G

AutoUpdate=registry

[Install]
WantedBy=multi-user.target

[Unit]
Description=Tailscale Funnel for BookOrbit
After=tailscaled.service network-online.target
Wants=network-online.target
Requires=tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Publish only BookOrbit on the node's public ts.net name (TLS by Tailscale).
# Backend is the rootless BookOrbit pod published on the host at :3001
# (host :3000 is taken by SilverBullet).
# Use 8443 (not 443) so it doesn't shadow Caddy on the node's tailnet
# :443 for babariviere.com hosts reached over the tailnet.
ExecStart=/usr/bin/tailscale funnel --bg --https=8443 http://127.0.0.1:3001
ExecStop=/usr/bin/tailscale funnel --https=8443 off

[Install]
WantedBy=multi-user.target

*.babariviere.com {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1
	}

	@paperless host paperless.babariviere.com
	handle @paperless {
		reverse_proxy paperless:8000
	}

	@bridge host bridge.babariviere.com
	handle @bridge {
		reverse_proxy host.containers.internal:8581
	}

	@notes host notes.babariviere.com
	handle @notes {
		reverse_proxy silverbullet:3000
	}

	@letta host letta.babariviere.com
	handle @letta {
		reverse_proxy letta:8283
	}

	@lettabot host bot.babariviere.com
	handle @lettabot {
		reverse_proxy letta:8080
	}
}

